# ESP-IDF Configuration defaults for NAT Router
CONFIG_LWIP_IP_FORWARD=y
CONFIG_LWIP_IPV4_NAPT=y
CONFIG_LWIP_TCPIP_CORE_LOCKING=y

# Số socket lwIP: httpd cần max_open_sockets(7) + 3 socket nội bộ = 10, trong khi DNS server dùng
# thêm 2 socket và HTTP client kiểm tra internet dùng 1. Mặc định 10 => khi trình duyệt mở đủ
# kết nối thì socket DNS/HTTP client bị hết chỗ. 16 là mức tối đa của lwIP trong ESP-IDF.
CONFIG_LWIP_MAX_SOCKETS=16

# Task watchdog: app_main() đặt lại timeout 45 s qua esp_task_wdt_reconfigure().
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=y
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=y

# Dung lượng flash do PlatformIO lấy từ manifest của từng board (esp32dev, esp32-s3-devkitc-1...),
# không đặt cứng ở đây để khỏi sai với board 2 MB / 8 MB / 16 MB.

# Bảng phân vùng do platformio.ini chọn (board_build.partitions = partitions.csv),
# vì phân vùng app mặc định 1 MB không đủ cho một số chip (vd. ESP32-C6 ~1.07 MB).

# Biên dịch tối ưu kích thước (-Os): giảm đáng kể firmware, không ảnh hưởng chức năng.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_SILENT=y

# Giảm thêm kích thước firmware (các tính năng dưới đây không được dùng):
# - Kiểm tra internet chỉ dùng HTTP thuần => bỏ hỗ trợ HTTPS trong esp_http_client (bớt kéo TLS).
CONFIG_ESP_HTTP_CLIENT_ENABLE_HTTPS=n
# - Firmware chỉ dùng IPv4.
CONFIG_LWIP_IPV6=n
