{
  "build": {
    "arduino": {
      "ldscript": "esp32c5_out.ld"
    },
    "core": "esp32",
    "extra_flags": [
      "-DARDUINO_ESP32C5_DEV",
      "-DARDUINO_ARCH_ESP32",
      "-DARDUINO_FQSPI",
      "-DCONFIG_IDF_TARGET_ESP32C5"
    ],
    "f_cpu": "240000000L",
    "f_flash": "80000000L",
    "flash_mode": "qio",
    "mcu": "esp32c5",
    "variant": "esp32c5"
  },
  "connectivity": [
    "wifi",
    "bluetooth",
    "ethernet"
  ],
  "debug": {
    "openocd_target": "esp32c5"
  },
  "frameworks": [
    "arduino",
    "espidf"
  ],
  "name": "Espressif ESP32-C5-M4-EVK",
  "upload": {
    "flash_size": "4MB",
    "maximum_ram_size": 409600,
    "maximum_size": 4194304,
    "require_upload_port": true,
    "speed": 460800
  },
  "url": "https://www.espressif.com/en/products/socs/esp32-c5",
  "vendor": "Espressif"
}
